# Fourni par Neon (ou tout autre Postgres) — voir README pour l'obtenir
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# Choisis un mot de passe fort — c'est lui qui protège /admin
ADMIN_SECRET="change-moi"

# Lien d'invitation Discord (utilisé sur les pages compte et middleman)
DISCORD_INVITE_URL="https://discord.gg/ton-invite"

# Pour recevoir un mail quand un acheteur demande un Middleman — clé API sur resend.com (gratuit)
RESEND_API_KEY="re_xxx"
NOTIFY_EMAIL="ton-email@example.com"
