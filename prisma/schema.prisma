generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Listing {
  id         String   @id @default(cuid())
  title      String
  price      Int // en dollars, entier (ex: 425)
  level      Int
  sellerName String
  sellerDiscord String? // mémo interne : pseudo Discord du vendeur, jamais affiché publiquement
  sellerEmail String? // mémo interne : email du vendeur, jamais affiché publiquement
  sellerPhone String? // mémo interne : téléphone du vendeur (avec indicatif), jamais affiché publiquement
  middlemanRequested Boolean @default(false) // un acheteur a demandé un intermédiaire pour ce compte (à traiter côté admin)
  accountType String? // archers | berserker | cavalry — type de compte confirmé par le vendeur
  verified   Boolean  @default(false)
  rating     Float?
  statLine   String // ex: "120 Skins · 45 Characters · High Rune Collection"
  imageLabel String? // ex: "Account overview" (placeholder tant que pas de vraies captures)
  tag        String? // ex: "Featured", ou vide
  middleman  Boolean  @default(true)
  featured   Boolean  @default(false)
  status     String   @default("active") // active | sold | removed
  troopsInfo String? // texte libre : nombre de troupes, infos complémentaires
  createdAt  DateTime @default(now())
  images     ListingImage[]
  messages   Message[]
}

// Une messagerie = un acheteur. Le fil est unique par acheteur (identifié par
// un token privé stocké dans un cookie httpOnly), pas par annonce : un même
// acheteur qui discute de plusieurs comptes reste dans le même fil, chaque
// message pouvant référencer l'annonce concernée (listingId).
model Conversation {
  id            String    @id @default(cuid())
  token         String    @unique // jamais affiché, sert uniquement au cookie navigateur de l'acheteur
  buyerDiscord  String // pseudo Discord donné par l'acheteur à l'ouverture du fil
  createdAt     DateTime  @default(now())
  lastMessageAt DateTime  @default(now())
  unreadByAdmin Boolean   @default(true) // un nouveau message acheteur est arrivé, pas encore vu en admin
  unreadByBuyer Boolean   @default(false) // une réponse admin est arrivée, pas encore vue par l'acheteur
  messages      Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String // "buyer" | "admin"
  body           String? // texte du message ; optionnel si le message n'est qu'une image
  imageUrl       String? // capture d'écran jointe au message, hébergée sur Vercel Blob
  listingId      String? // annonce concernée par ce message, si applicable
  listing        Listing?     @relation(fields: [listingId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
}

model ListingImage {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  category  String? // overview | characters | runes | inventory | equipment | skins | other
  sortOrder Int     @default(0)
}
